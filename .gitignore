# docs/ is now a git SUBMODULE (private repo Bachelor_Thesis_Docs), tracked as a
# gitlink in this parent repo — so it must NOT be ignored. Its own contents are
# versioned by the docs repo itself (see .gitmodules).

# --- Papers / PDFs ---
*.pdf
# (the supervisor's coded-marker spec PDF now lives in the docs submodule, tracked there — no whitelist needed here)

# --- Hydra logs (now disabled via `override /hydra/job_logging: disabled` in each config — this is the safety net) ---
# *.log already covered by **/*.log at top
logs/

# ALIKED CUDA-12 onnxruntime libs (~2.5 GB) — persistent local copy, never commit/rsync
tools/cuda12libs/

# Local scratch / working files — one-off aggregation scripts + generated table fragments (not part of the codebase)
scratchpad/

# Hydra per-run output dirs (timestamped .hydra config snapshots — throwaway byproduct of @hydra.main scripts)
outputs/

# --- scripts/ : the public repo ships ONLY the reusable templates + README. The authors'
#     per-experiment Euler run scripts hardcode a cluster path + account and aren't reusable,
#     so they stay local-only (still on disk, just untracked). Templates are whitelisted below. ---
scripts/*
!scripts/README.md
!scripts/example_*_job.sh
